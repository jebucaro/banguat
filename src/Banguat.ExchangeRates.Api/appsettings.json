{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "AllowedOrigins": []
  },
  "HttpCaching": {
    "StaleWhileRevalidate": "00:01:00",
    "StaleIfError": "1.00:00:00",
    "MinimumMaxAge": "00:00:30"
  }
}
